# OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (Optional - for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google OAuth (Optional - for Gmail/Drive/Calendar tools)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback

# Security (Change these in production!)
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database (Auto-configured by Docker, no need to change)
# DATABASE_URL=postgresql://turfmapp_agent:Z3c2et-2025@postgres:5432/turfmapp_dev

# Supabase (Optional - if using cloud Supabase instead of local DB)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3005,http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3005

# Logging
LOG_LEVEL=INFO
